# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Ambientes virtuais
.venv/
venv/
env/

# Build / distribuicao
build/
dist/
*.spec.bak
diagnostico.txt
diagnostico_camera.txt

# Pasta de entrega: ignorada, exceto o executavel portatil, que e
# versionado de proposito para distribuicao direta pelo GitHub.
# (O sidecar eye-core e a pasta com centenas de MB nao entram no repositorio.)
entrega/**
!entrega/Prancha Assistiva/
!entrega/Prancha Assistiva/Prancha Assistiva.exe

# Dados de runtime
logs/*.log
perfis/*.json
!perfis/.gitkeep
# O modelo do MediaPipe e versionado de proposito: assim o clone roda
# offline e o build do instalador nao depende de download. Outros .task
# continuam fora do repositorio.
models/*.task
!models/.gitkeep
!models/face_landmarker.task

# Sidecar empacotado pelo PyInstaller (gerado por npm run sidecar)
prototipo_tauri/src-tauri/resources/eye-core/

# Capturas de tela
prototipo_tauri/capturas/

# O sandbox visual preview_novo_design/ e versionado: os testes
# (tests/test_preview_design.py) importam o pacote, entao um clone
# precisa dele. Ele so desenha telas com Pillow, sem camera/MediaPipe.

# Sistema
.DS_Store
Thumbs.db
